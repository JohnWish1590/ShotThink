{
  "manifest_version": 3,
  "name": "ShotThink：网页截图问 ChatGPT",
  "version": "1.2.0",
  "description": "框选网页内容、圈出重点，一键发到你已登录的 ChatGPT 对话；支持长截图和右键发送选中文字，无需单独配置 API Key ",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ShotThink — capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "capture": {
      "suggeted_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture the visible area"
    }
  },
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icons16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "28": "icons/icon128.png"
  }
}
